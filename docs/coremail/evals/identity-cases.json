    {
      "id": "mentions",
      "request": "我是研发一部的李宁，工作邮箱 ning.li@work.example.invalid，ln@work.example.invalid 是我确认过的邮箱别名。请从下面这些工作邮件中找出本封正文提到我的邮件，并列出需要我处理的事项；历史引用里的提及单独列出。",
      "sources": {
        "listAccount": {
          "code": 0,
          "var": [
            {
              "AccountID": 41,
              "AccountName": "ning.li@work.example.invalid",
              "DisplayName": "李宁",
              "Offline": false
            }
          ]
        },
        "mails": [
          {
            "Account": "ning.li@work.example.invalid",
            "ID": 101,
            "To": [
