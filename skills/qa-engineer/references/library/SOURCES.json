{
  "schema_version": 1,
  "policy": {
    "purpose": "Build a local, progressive quality-engineering curriculum from authoritative, redistributable testing sources.",
    "selection_rules": [
      "Prefer standards bodies, project owners, and mature open-source testing projects over popularity alone.",
      "Mirror only material that teaches a QA decision, test mechanism, oracle, integration boundary, or verification practice.",
      "Keep tool-specific material subordinate to the consuming project's configured version and test architecture.",
      "Pin every sync to the resolved upstream commit and verify downloaded Git blobs byte-for-byte.",
      "Preprocess supported document formats into agent-ready Markdown while preserving exact originals and provenance.",
      "Do not vendor proprietary certification syllabi, paid standards, books, or ambiguous-license material."
    ]
  },
