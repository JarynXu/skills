{
  "schema_version": 1,
  "policy": {
    "purpose": "Build a local, progressive backend-engineering curriculum from canonical and widely adopted sources.",
    "selection_rules": [
      "Prefer formal specifications, language/project owners, and mature community consensus over popularity alone.",
      "Pair classic material with current specifications when the classic is dated.",
      "Vendor only material whose exact source can be redistributed under known terms.",
      "Record important restricted works in the curriculum, but never mirror them without permission.",
      "Pin every sync to the resolved upstream commit and verify every downloaded Git blob byte-for-byte.",
      "Mirror only the parts of large documentation sets that teach a backend engineering decision or provide an important reference."
    ]
  },
  "sources": [
