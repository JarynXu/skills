{
  "schema_version": 1,
  "policy": {
    "purpose": "Build a local, progressive DevOps and platform-engineering curriculum from authoritative, redistributable delivery, runtime, observability, infrastructure, GitOps, and supply-chain sources.",
    "selection_rules": [
      "Prefer standards bodies, project owners, and primary upstream documentation over secondary tutorials or popularity alone.",
      "Mirror only material that changes an operational, delivery, reliability, security, recovery, or platform-engineering decision.",
      "Keep tool-specific material subordinate to the consuming project's configured version, organization policy, cloud account, cluster, state backend, and release process.",
      "Pin every sync to the resolved upstream commit and verify downloaded Git blobs byte-for-byte.",
      "Preprocess supported document formats into agent-ready Markdown while preserving exact originals and provenance.",
      "Do not vendor MDX-only documentation until the preprocessing pipeline has an explicit tested MDX contract.",
      "Do not vendor paid standards, proprietary vendor training, certification books, or ambiguous-license material."
    ]
  },
